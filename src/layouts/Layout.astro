---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';

import { getEntry } from 'astro:content';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const { 
	title = "Portal Rancajaya", 
	description = "Portal informasi resmi Desa Rancajaya",
	image = "/images/SawahRancajaya.jpg"
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : Astro.url.origin;
const origin = Astro.site ? new URL(Astro.site).origin : Astro.url.origin;

// Get data for Structured Data
const umumData = await getEntry('pengaturan', 'umum');
const common = umumData?.data || {};

const schema = {
	"@context": "https://schema.org",
	"@type": "GovernmentOrganization",
	"name": `Pemerintah Desa ${common.nama_desa || 'Rancajaya'}`,
	"alternateName": `Desa ${common.nama_desa || 'Rancajaya'}`,
	"description": `Portal resmi Pemerintah Desa ${common.nama_desa || 'Rancajaya'}, Kecamatan ${common.kecamatan || 'Patokbeusi'}, Kabupaten ${common.kabupaten || 'Subang'}, Jawa Barat.`,
	"url": siteUrl,
	"logo": `${origin}${base}/images/logo.png`,
	"address": {
		"@type": "PostalAddress",
		"streetAddress": common.alamat_kantor || "",
		"addressLocality": common.kecamatan || "",
		"addressDistrict": common.kabupaten || "",
		"addressRegion": common.provinsi || "",
		"postalCode": "41263",
		"addressCountry": "ID"
	},
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": common.koordinat_latitude,
		"longitude": common.koordinat_longitude
	},
	"contactPoint": {
		"@type": "ContactPoint",
		"telephone": common.telepon?.replace(/[^+\d]/g, '') || "",
		"contactType": "customer service"
	},
	"sameAs": [common.facebook, common.youtube].filter(Boolean),
	"areaServed": `${common.kecamatan || 'Patokbeusi'}, ${common.kabupaten || 'Subang'}`
};
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="google-site-verification" content="2T53iT9OhlWzpFiAcPSKeHOdENIX1qg4UGAr2E_iabc" />
		<link rel="icon" type="image/png" href={`${base}/images/logo.png`} />
		<link rel="sitemap" href={`${base}/sitemap-index.xml`} />
		<meta name="generator" content={Astro.generator} />
		<meta property="og:site_name" content={`Portal Desa ${common.nama_desa || 'Rancajaya'}`} />
		<Seo title={title} description={description} image={image} schema={schema} />
		
	</head>
	<body class="flex flex-col min-h-screen">
		<Navbar />
		<main class="flex-grow">
			<slot />
		</main>
		<Footer />
	</body>
</html>
