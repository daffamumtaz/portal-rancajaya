---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

import { getEntry } from 'astro:content';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const { 
	title = "Portal Rancajaya", 
	description = "Portal informasi resmi Desa Rancajaya",
	image = "/images/SawahRancajaya.jpg"
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://neuraly4.github.io/portal-rancajaya';
const imageUrl = `${siteUrl}${image}`;

// Get data for Structured Data
const umumData = await getEntry('pengaturan', 'umum');
const common = umumData?.data || {};

const schema = {
	"@context": "https://schema.org",
	"@type": "GovernmentOrganization",
	"name": `Pemerintah Desa ${common.nama_desa || 'Rancajaya'}`,
	"url": siteUrl,
	"logo": `${siteUrl}/images/logo.png`,
	"address": {
		"@type": "PostalAddress",
		"streetAddress": common.alamat_kantor || "",
		"addressLocality": common.kecamatan || "",
		"addressRegion": common.provinsi || "",
		"addressCountry": "ID"
	},
	"contactPoint": {
		"@type": "ContactPoint",
		"telephone": common.telepon || "",
		"contactType": "customer service"
	}
};
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/png" href={`${base}/images/logo.png`} />
		<link rel="sitemap" href={`${base}/sitemap-index.xml`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Open Graph / SEO -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:site_name" content={`Portal Desa ${common.nama_desa || 'Rancajaya'}`} />
		
		<!-- Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
		
	</head>
	<body class="flex flex-col min-h-screen">
		<Navbar />
		<main class="flex-grow">
			<slot />
		</main>
		<Footer />
	</body>
</html>
