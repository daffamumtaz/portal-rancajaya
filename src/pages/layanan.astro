---
import { getEntry, getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { isPublishedContent, toGoogleMapsEmbedUrl, toGoogleMapsUrl, toSafeFormUrl, toWhatsAppHref } from '../utils/content';

const umumData = await getEntry('pengaturan', 'umum');
const common = isPublishedContent(umumData?.data) ? umumData.data : {};
const layananData = await getEntry('halaman', 'layanan');
const layananPage = isPublishedContent(layananData?.data) ? layananData.data : {};
const administrasiData = (await getCollection('layanan-administrasi')).filter((entry) => isPublishedContent(entry.data)).sort((a, b) => a.data.urutan - b.data.urutan);
const kontakData = (await getCollection('kontak')).filter((entry) => isPublishedContent(entry.data)).sort((a, b) => a.data.urutan - b.data.urutan);
const kontakUtama = kontakData.find((kontak) => kontak.data.jenis === 'Desa');
const formUrl = toSafeFormUrl(administrasiData.find((item) => item.data.link)?.data.link);
const layananMapZoom = common.peta_zoom || 18;
const mapEmbedUrl = toGoogleMapsEmbedUrl(common.koordinat_latitude, common.koordinat_longitude, layananMapZoom, common.peta_query);
const mapUrl = toGoogleMapsUrl(common.koordinat_latitude, common.koordinat_longitude, common.peta_url);
---

<Layout title={`Layanan Publik - ${common.nama_desa || 'Desa Rancajaya'}`} description={`Layanan administrasi dan kontak Balai Desa Rancajaya, Kecamatan ${common.kecamatan || 'Patokbeusi'}, Kabupaten ${common.kabupaten || 'Subang'}, Jawa Barat.`}>
  <Hero eyebrow="Layanan" title={layananPage.hero_title || 'Layanan Desa'} subtitle={layananPage.hero_subtitle || `Informasi layanan administrasi dan kontak penting di lingkungan ${common.nama_desa || 'Desa Rancajaya'}`} />

  <section class="section">
    <div class="container-page"><div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <aside class="lg:col-span-4 space-y-6">
        <div class="card p-6"><h3 class="font-display font-bold text-lg text-ink mb-4">Kontak Desa</h3><ul class="flex flex-col gap-4 text-sm">
          <li class="flex items-start gap-3"><span class="text-primary-600">⌖</span><span class="text-muted leading-relaxed">{kontakUtama?.data.alamat || common.alamat_kantor || 'Alamat kantor belum diisi'}</span></li>
          <li class="flex items-center gap-3"><span class="text-primary-600">✉</span><span class="text-muted">{kontakUtama?.data.email || common.email || 'Email belum diisi'}</span></li>
          <li class="flex items-center gap-3"><span class="text-primary-600">☎</span>{toWhatsAppHref(kontakUtama?.data.telepon || common.telepon) ? <a href={toWhatsAppHref(kontakUtama?.data.telepon || common.telepon)} target="_blank" rel="noopener noreferrer" class="text-primary-700 font-semibold hover:underline">{kontakUtama?.data.telepon || common.telepon}</a> : <span class="text-muted">{kontakUtama?.data.telepon || common.telepon || 'Telepon belum diisi'}</span>}</li>
        </ul><div class="mt-6 pt-6 border-t border-line"><h4 class="font-semibold text-sm text-ink mb-2">Jam Pelayanan</h4><span class="text-sm text-muted">{common.jam_operasional || 'Senin - Jumat 08:00 - 16:00'}</span></div></div>
        <div class="card overflow-hidden bg-paper border border-line"><div class="h-80 md:h-96"><iframe src={mapEmbedUrl} title={`Peta satelit Balai Desa ${common.nama_desa || 'Rancajaya'}`} width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div><div class="px-5 py-4 border-t border-line bg-white flex items-center justify-between gap-4"><div><h3 class="font-display font-bold text-sm text-ink">Balai Desa Rancajaya</h3><p class="text-xs text-muted mt-1">Tampilan satelit lokasi balai desa</p></div><a href={mapUrl} class="text-xs font-semibold text-primary-700 hover:underline whitespace-nowrap" target="_blank" rel="noopener noreferrer">Buka di Maps</a></div></div>
      </aside>

      <div class="lg:col-span-8 space-y-10">
        <section><span class="eyebrow">Surat Daring</span><h2 class="font-display font-bold text-2xl text-ink mt-2">Layanan Surat Daring</h2><p class="text-sm text-muted mt-3 max-w-2xl">Pilih jenis surat yang dibutuhkan, lalu isi formulir yang sama. Jenis surat lainnya akan ditambahkan bertahap.</p>{formUrl && <a href={formUrl} class="btn-primary inline-flex mt-5" target="_blank" rel="noopener noreferrer">Isi Formulir Surat Daring</a>}
          <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">{administrasiData.map((item) => <article class="card p-5"><h3 class="font-bold text-ink">{item.data.nama}</h3><p class="text-sm text-muted mt-2">{item.data.deskripsi}</p></article>)}{administrasiData.length === 0 && <p class="text-sm text-muted">Jenis surat akan segera ditambahkan.</p>}</div>
        </section>
        <section><h2 class="font-display font-bold text-2xl text-ink mb-4">Kontak Penting</h2><div class="grid grid-cols-1 sm:grid-cols-2 gap-4">{kontakData.map((kontak) => { const whatsappHref = toWhatsAppHref(kontak.data.telepon); return <article class="card p-4 flex items-center justify-between gap-4 border-l-4 border-l-primary-500"><div><span class="font-bold text-ink text-sm block">{kontak.data.nama}</span><span class="text-xs text-muted">{kontak.data.deskripsi}</span>{whatsappHref && <p class="text-xs text-muted mt-2">Klik nomor untuk menghubungi via WhatsApp.</p>}</div>{whatsappHref ? <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-primary-700 hover:underline whitespace-nowrap">{kontak.data.telepon}</a> : <span class="text-sm text-muted">Menyusul</span>}</article>; })}</div></section>
      </div>
    </div></div>
  </section>
</Layout>
