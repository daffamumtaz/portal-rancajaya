---
import { getEntry, getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StatCard from '../components/StatCard.astro';
import { resolvePublicPath } from '../utils/content';

const profilData = await getEntry('halaman', 'profil');
const umumData = await getEntry('pengaturan', 'umum');
const profil = profilData?.data || {};
const common = umumData?.data || {};
const strukturOrganisasi = await getCollection('struktur-organisasi');
const dusunEntries = await getCollection('dusun');
const apbdesEntries = await getCollection('apbdes');
const sortedStruktur = strukturOrganisasi.sort((a, b) => a.data.urutan - b.data.urutan);
const sortedDusun = dusunEntries.sort((a, b) => a.data.urutan - b.data.urutan);

const orgNodes = sortedStruktur.map((entry) => ({ ...entry, children: [] }));
const orgById = new Map(orgNodes.map((node) => [node.id, node]));
const orgRoots = [];
orgNodes.forEach((node) => {
  const parent = node.data.parent ? orgById.get(node.data.parent) : undefined;
  if (parent) parent.children.push(node);
  else orgRoots.push(node);
});

const apbdesPendapatan = apbdesEntries
  .filter((entry) => entry.data.jenis === 'Pendapatan')
  .sort((a, b) => b.data.jumlah - a.data.jumlah)
  .slice(0, 5);
const apbdesBelanja = apbdesEntries
  .filter((entry) => entry.data.jenis === 'Belanja')
  .sort((a, b) => b.data.jumlah - a.data.jumlah)
  .slice(0, 5);
const totalPendapatan = apbdesEntries
  .filter((entry) => entry.data.jenis === 'Pendapatan')
  .reduce((sum, entry) => sum + entry.data.jumlah, 0);
const totalBelanja = apbdesEntries
  .filter((entry) => entry.data.jenis === 'Belanja')
  .reduce((sum, entry) => sum + entry.data.jumlah, 0);
const formatRupiah = (value) => new Intl.NumberFormat('id-ID', {
  style: 'currency',
  currency: 'IDR',
  maximumFractionDigits: 0,
}).format(value);
const demoDusun = sortedDusun
  .filter((entry) => typeof entry.data.jumlah_penduduk === 'number')
  .map((entry) => ({ label: entry.data.nama, value: entry.data.jumlah_penduduk }));

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fotoKades = resolvePublicPath(profil.foto_kades, base);
---

<Layout title={`Profil Desa - ${common.nama_desa || 'Desa Rancajaya'}`} description={`Profil lengkap Desa ${common.nama_desa || 'Rancajaya'} meliputi visi misi, perangkat desa, wilayah administrasi, demografi, dan transparansi APBDes.`}>

  <!-- 1. Hero -->
  <Hero
    eyebrow="Profil"
    title={`Profil Desa ${common.nama_desa || 'Rancajaya'}`}
    subtitle={`Mengenal lebih dekat Desa ${common.nama_desa || 'Rancajaya'}, Kecamatan ${common.kecamatan || 'Patokbeusi'}, Kabupaten ${common.kabupaten || 'Subang'}`}
  />

  <!-- 2. Sambutan Kepala Desa -->
  <section class="section bg-white">
    <div class="container-page">
      <div class="section-header">
        <span class="eyebrow animate-fade-in-up">Sambutan</span>
        <h2 class="section-title animate-fade-in-up stagger-1">Sambutan Kepala Desa</h2>
      </div>
      <div class="card p-6 md:p-8 animate-fade-in-up stagger-2">
        <div class="flex flex-col md:flex-row gap-6 md:gap-8">
          <!-- Photo Placeholder Left -->
          <div class="flex-shrink-0 text-center md:text-left">
            <div class="w-32 h-40 bg-gradient-to-br from-primary-200 via-primary-100 to-primary-50 rounded-xl mx-auto md:mx-0 flex items-center justify-center">
              {fotoKades ? (
                <img src={fotoKades} alt={profil.nama_kades || 'Kepala Desa'} class="w-full h-full object-cover rounded-xl" />
              ) : (
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary-300">
                  <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              )}
            </div>
            <h3 class="font-bold text-ink mt-3">{profil.nama_kades || '[Nama Kepala Desa]'}</h3>
            <p class="text-sm text-muted">Kepala Desa {common.nama_desa || 'Rancajaya'}</p>
          </div>

          <!-- Quote/Greeting Right -->
          <div class="flex-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-primary-200 mb-3">
              <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"></path>
              <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"></path>
            </svg>
            {profil.sambutan ? (
              profil.sambutan.split('\n').map((paragraph) => (
                paragraph.trim() && <p class="text-muted leading-relaxed italic mb-4">{paragraph}</p>
              ))
            ) : (
              <p class="text-muted leading-relaxed italic mb-4">"Sambutan belum tersedia."</p>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2b. Quick Navigation -->
  <section class="container-page -mt-4 relative z-20 mb-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <a href="#tentang-desa" class="card-hover p-4 flex flex-col items-center justify-center text-center group bg-white shadow-sm">
        <span class="font-semibold text-sm text-ink group-hover:text-primary-700">Tentang Desa</span>
      </a>
      <a href="#struktur-organisasi" class="card-hover p-4 flex flex-col items-center justify-center text-center group bg-white shadow-sm">
        <span class="font-semibold text-sm text-ink group-hover:text-primary-700">Struktur Tree</span>
      </a>
      <a href="#demografi" class="card-hover p-4 flex flex-col items-center justify-center text-center group bg-white shadow-sm">
        <span class="font-semibold text-sm text-ink group-hover:text-primary-700">Demografi</span>
      </a>
      <a href="#apbdes" class="card-hover p-4 flex flex-col items-center justify-center text-center group bg-white shadow-sm">
        <span class="font-semibold text-sm text-ink group-hover:text-primary-700">Transparansi APBDes</span>
      </a>
    </div>
  </section>

  <!-- 3. Visi & Misi -->
  <section id="tentang-desa" class="section bg-paper">
    <div class="container-page">
      <div class="section-header">
        <span class="eyebrow">Tentang Desa</span>
        <h2 class="section-title">Visi & Misi</h2>
      </div>

      <!-- Visi -->
      <div class="card p-6 md:p-8 mb-8 text-center border-primary-200 bg-gradient-to-br from-white to-primary-50 animate-fade-in-up stagger-2">
        <span class="eyebrow text-primary-700">Visi</span>
        <p class="text-lg md:text-xl font-display font-bold text-ink mt-3 leading-relaxed">
          "{common.visi || 'Visi belum tersedia'}"
        </p>
      </div>

      <!-- Misi -->
      <div>
        <h3 class="text-center font-display font-bold text-ink mb-6">Misi</h3>
        <div class="grid md:grid-cols-2 gap-4">
          {common.misi && common.misi.length > 0 ? (
            common.misi.map((misiItem, index) => (
              <div class="card p-5 animate-fade-in-up">
                <div class="flex gap-4">
                  <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-primary-700 text-white flex items-center justify-center font-bold font-display text-sm">{index + 1}</div>
                  <p class="text-muted leading-relaxed">{misiItem}</p>
                </div>
              </div>
            ))
          ) : (
            <p class="text-center text-muted col-span-2">Misi belum tersedia.</p>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Struktur Organisasi -->
  <section id="struktur-organisasi" class="section bg-white">
    <div class="container-page">
      <div class="section-header">
        <span class="eyebrow animate-fade-in-up">Struktur Organisasi</span>
        <h2 class="section-title animate-fade-in-up stagger-1">Struktur Tree Pemerintahan Desa</h2>
        <p class="section-subtitle animate-fade-in-up stagger-2">Data struktur ini berasal dari collection Decap CMS dan dapat disusun dengan parent node.</p>
      </div>

      {orgRoots.length > 0 ? (
        <div class="space-y-8">
          {orgRoots.map((root) => (
            <div class="flex flex-col items-center">
              <div class="card p-5 text-center w-full max-w-xs border-primary-200 bg-primary-50">
                <h3 class="font-bold text-ink">{root.data.jabatan}</h3>
                <p class="text-sm text-primary-700 font-semibold mt-1">{root.data.nama}</p>
                {root.data.deskripsi && <p class="text-xs text-muted mt-2">{root.data.deskripsi}</p>}
              </div>

              {root.children.length > 0 && (
                <div class="mt-6 w-full">
                  <div class="mx-auto h-6 w-px bg-line"></div>
                  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    {root.children.map((child) => (
                      <div class="flex flex-col items-center">
                        <div class="card p-4 text-center w-full">
                          <h4 class="font-semibold text-sm text-ink">{child.data.jabatan}</h4>
                          <p class="text-xs text-primary-700 font-semibold mt-1">{child.data.nama}</p>
                          {child.data.deskripsi && <p class="text-xs text-muted mt-2">{child.data.deskripsi}</p>}
                        </div>

                        {child.children.length > 0 && (
                          <div class="mt-4 w-full space-y-3">
                            {child.children.map((grandChild) => (
                              <div class="card p-3 text-center bg-paper">
                                <h5 class="font-semibold text-xs text-ink">{grandChild.data.jabatan}</h5>
                                <p class="text-xs text-muted">{grandChild.data.nama}</p>
                              </div>
                            ))}
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>
      ) : (
          <p class="text-muted text-center">Data struktur organisasi belum ditambahkan.</p>
        )}
    </div>
  </section>

  <!-- 5. Wilayah Administrasi -->
  <section class="section bg-paper">
    <div class="container-page">
      <div class="section-header">
        <span class="eyebrow animate-fade-in-up">Wilayah</span>
        <h2 class="section-title animate-fade-in-up stagger-1">Wilayah Administrasi</h2>
        <p class="section-subtitle animate-fade-in-up stagger-2">Batas wilayah dan pembagian dusun Desa Rancajaya</p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- Batas Wilayah Table -->
        <div class="card overflow-hidden animate-fade-in-up stagger-1">
          <div class="px-5 py-4 bg-primary-700">
            <h3 class="font-display font-bold text-white text-sm flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              Batas Wilayah
            </h3>
          </div>
          <div class="divide-y divide-line">
            {(profil.batas_wilayah || []).map((batas) => (
              <div class="flex justify-between gap-4 px-5 py-3">
                <span class="text-sm font-medium text-ink">{batas.arah}</span>
                <span class="text-sm text-muted text-right">{batas.wilayah}</span>
              </div>
            ))}
            {(!profil.batas_wilayah || profil.batas_wilayah.length === 0) && (
              <p class="px-5 py-4 text-sm text-muted">Data batas wilayah belum ditambahkan.</p>
            )}
          </div>
          <div class="px-5 py-3 bg-primary-50 flex justify-between">
            <span class="text-sm font-bold text-primary-700">Luas Wilayah</span>
            <span class="text-sm font-bold text-primary-700">{profil.luas_wilayah || '0'} km2</span>
          </div>
        </div>

        <!-- Dusun List -->
        <div class="card overflow-hidden animate-fade-in-up stagger-2">
          <div class="px-5 py-4 bg-primary-700">
            <h3 class="font-display font-bold text-white text-sm flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
              Pembagian Dusun
            </h3>
          </div>
          <div class="divide-y divide-line">
            {sortedDusun.map((dusun, i) => (
              <div class="flex items-center gap-4 px-5 py-4">
                <div class="w-10 h-10 rounded-xl bg-primary-50 flex items-center justify-center flex-shrink-0">
                  <span class="text-sm font-bold text-primary-700">{i + 1}</span>
                </div>
                <div>
                  <h4 class="font-semibold text-sm text-ink">Dusun {dusun.data.nama}</h4>
                  <p class="text-xs text-muted">{dusun.data.kepala_dusun || 'Kepala dusun belum diisi'} / {dusun.data.jumlah_penduduk || 0} jiwa</p>
                  <p class="text-xs text-muted mt-1">{dusun.data.deskripsi}</p>
                </div>
              </div>
            ))}
            {sortedDusun.length === 0 && (
              <p class="px-5 py-4 text-sm text-muted">Data dusun belum ditambahkan.</p>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Demografi -->
  <section id="demografi" class="section bg-white">
    <div class="container-page">
      <div class="section-header">
        <span class="eyebrow">Data Penduduk</span>
        <h2 class="section-title">Demografi</h2>
        <p class="section-subtitle">Visualisasi data kependudukan Desa {common.nama_desa || 'Rancajaya'}</p>
      </div>

      <!-- Stat Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        <StatCard value={`${profil.penduduk_total || '0'}`} label="Total Penduduk (Jiwa)" variant="dark" />
        <StatCard value={`${profil.penduduk_pria || '0'}`} label="Laki-laki (Jiwa)" />
        <StatCard value={`${profil.penduduk_wanita || '0'}`} label="Perempuan (Jiwa)" />
      </div>

      <!-- Charts -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Dusun Pie Chart -->
        <div class="card p-6">
          <h3 class="font-display font-bold text-ink text-sm mb-4">Populasi per Dusun</h3>
          <div class="relative h-64 w-full">
            <canvas id="chartDusun"></canvas>
          </div>
        </div>
        
        <!-- Pendidikan Bar Chart -->
        <div class="card p-6">
          <h3 class="font-display font-bold text-ink text-sm mb-4">Tingkat Pendidikan</h3>
          <div class="relative h-64 w-full">
            <canvas id="chartPendidikan"></canvas>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script is:inline define:vars={{ demoDusun, demoPendidikan: profil.demo_pendidikan || [] }}>
    document.addEventListener("DOMContentLoaded", function() {
      if (!window.Chart) return;

      // Dusun Chart
      if (demoDusun && demoDusun.length > 0) {
        const ctxDusun = document.getElementById('chartDusun').getContext('2d');
        new Chart(ctxDusun, {
          type: 'pie',
          data: {
            labels: demoDusun.map(d => d.label),
            datasets: [{
              data: demoDusun.map(d => d.value),
              backgroundColor: ['#16a34a', '#eab308', '#2563eb', '#dc2626', '#9333ea'],
            }]
          },
          options: { responsive: true, maintainAspectRatio: false }
        });
      }

      // Pendidikan Chart
      if (demoPendidikan && demoPendidikan.length > 0) {
        const ctxPendidikan = document.getElementById('chartPendidikan').getContext('2d');
        new Chart(ctxPendidikan, {
          type: 'bar',
          data: {
            labels: demoPendidikan.map(d => d.label),
            datasets: [{
              label: 'Jumlah Penduduk',
              data: demoPendidikan.map(d => d.value),
              backgroundColor: '#15803d',
            }]
          },
          options: { responsive: true, maintainAspectRatio: false }
        });
      }
    });
  </script>

  <!-- 7. Transparansi APBDes -->
  <section id="apbdes" class="section bg-paper">
    <div class="container-page">
      <div class="section-header">
        <span class="eyebrow">Keuangan Desa</span>
        <h2 class="section-title">Transparansi APBDes</h2>
        <p class="section-subtitle">Realisasi Anggaran Pendapatan dan Belanja Desa (APBDes)</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
        <!-- Pendapatan -->
        <div class="card p-6 text-center border-green-200 bg-gradient-to-br from-white to-green-50">
          <p class="text-xs text-muted uppercase tracking-wider font-semibold mb-1">Pendapatan</p>
          <p class="text-3xl font-display font-bold text-green-700">{formatRupiah(totalPendapatan)}</p>
        </div>

        <!-- Belanja -->
        <div class="card p-6 text-center border-blue-200 bg-gradient-to-br from-white to-blue-50">
          <p class="text-xs text-muted uppercase tracking-wider font-semibold mb-1">Belanja</p>
          <p class="text-3xl font-display font-bold text-blue-700">{formatRupiah(totalBelanja)}</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="card p-6">
          <h3 class="font-display font-bold text-ink text-sm mb-4">Top 5 Sumber Pendapatan</h3>
          <div class="relative h-80 w-full">
            <canvas id="chartPendapatan"></canvas>
          </div>
        </div>
        <div class="card p-6">
          <h3 class="font-display font-bold text-ink text-sm mb-4">Top 5 Belanja</h3>
          <div class="relative h-80 w-full">
            <canvas id="chartBelanja"></canvas>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{
    apbdesPendapatan: apbdesPendapatan.map((entry) => ({ label: entry.data.nama, value: entry.data.jumlah })),
    apbdesBelanja: apbdesBelanja.map((entry) => ({ label: entry.data.nama, value: entry.data.jumlah }))
  }}>
    document.addEventListener("DOMContentLoaded", function() {
      if (!window.Chart) return;

      function rupiah(value) {
        if (value >= 1000000000) return (value / 1000000000) + ' M';
        if (value >= 1000000) return (value / 1000000) + ' Jt';
        return value;
      }

      function renderBarChart(canvasId, rows, color) {
        const canvas = document.getElementById(canvasId);
        if (!canvas || !rows || rows.length === 0) return;

        new Chart(canvas.getContext('2d'), {
          type: 'bar',
          data: {
            labels: rows.map(d => d.label),
            datasets: [{
              label: 'Jumlah',
              data: rows.map(d => d.value),
              backgroundColor: color,
            }]
          },
          options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              x: {
                beginAtZero: true,
                ticks: {
                  callback: rupiah
                }
              }
            }
          }
        });
      }

      renderBarChart('chartPendapatan', apbdesPendapatan, '#16a34a');
      renderBarChart('chartBelanja', apbdesBelanja, '#2563eb');
    });
  </script>
</Layout>
