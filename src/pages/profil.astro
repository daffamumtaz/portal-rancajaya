---
import { getEntry, getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StatCard from '../components/StatCard.astro';
import { isPublishedContent } from '../utils/content';

const profilData = await getEntry('halaman', 'profil');
const umumData = await getEntry('pengaturan', 'umum');
const profil = isPublishedContent(profilData?.data) ? profilData.data : {};
const common = isPublishedContent(umumData?.data) ? umumData.data : {};
const strukturOrganisasi = (await getCollection('struktur-organisasi')).filter((entry) => isPublishedContent(entry.data));
const dusunEntries = (await getCollection('dusun')).filter((entry) => isPublishedContent(entry.data));
const allApbdesEntries = (await getCollection('apbdes')).filter((entry) => isPublishedContent(entry.data));
const apbdesPeriods = [...new Map(allApbdesEntries.map((entry) => {
  const key = `${entry.data.tahun}-${entry.data.versi.toLowerCase()}`;
  return [key, { key, tahun: entry.data.tahun, versi: entry.data.versi }];
})).values()].sort((a, b) => b.tahun - a.tahun || a.versi.localeCompare(b.versi));
const configuredApbdesYear = common.tahun_apbdes_aktif || new Date().getFullYear();
const activeApbdesPeriod = apbdesPeriods.find((period) => period.tahun === configuredApbdesYear && period.versi === 'Awal') || apbdesPeriods[0] || { key: `${configuredApbdesYear}-awal`, tahun: configuredApbdesYear, versi: 'Awal' };
const apbdesEntries = allApbdesEntries.filter((entry) => entry.data.tahun === activeApbdesPeriod.tahun && entry.data.versi === activeApbdesPeriod.versi);
const sortedStruktur = strukturOrganisasi.sort((a, b) => a.data.urutan - b.data.urutan);
const sortedDusun = dusunEntries.sort((a, b) => a.data.urutan - b.data.urutan);

const kepalaDesa = sortedStruktur.find((entry) => entry.data.jabatan === 'Kepala Desa');
const sekretarisDesa = sortedStruktur.find((entry) => entry.data.jabatan === 'Sekretaris Desa');
const organizationColumns = [
  ['Kaur Kesra', 'Kaur Umum', 'Kawil Dusun Buwer'],
  ['Kaur Pemerintahan', 'Staff', 'Kawil Dusun Mulyasari'],
  ['Kaur Keuangan', 'Staff', 'Kawil Dusun Sengon'],
].map((column, columnIndex) => column.map((jabatan, rowIndex) => {
  const matches = sortedStruktur.filter((entry) => entry.data.jabatan === jabatan);
  if (jabatan === 'Staff') return matches[columnIndex - 1];
  return matches[0];
}).filter(Boolean));

const totalPendapatan = apbdesEntries
  .filter((entry) => entry.data.jenis === 'Pendapatan')
  .reduce((sum, entry) => sum + entry.data.jumlah, 0);
const totalBelanja = apbdesEntries
  .filter((entry) => entry.data.jenis === 'Belanja')
  .reduce((sum, entry) => sum + entry.data.jumlah, 0);
const totalSaldo = totalPendapatan - totalBelanja;
const formatRupiah = (value) => new Intl.NumberFormat('id-ID', {
  style: 'currency',
  currency: 'IDR',
  maximumFractionDigits: 0,
}).format(value);
const demoDusun = sortedDusun
  .filter((entry) => typeof entry.data.jumlah_penduduk === 'number')
  .map((entry) => ({ label: entry.data.nama, value: entry.data.jumlah_penduduk }));
const pendidikanRows = profil.demo_pendidikan || [];
const umurRows = profil.demografi_umur || [];
const pekerjaanRows = profil.data_pekerjaan_warga || [];
const formatNumber = (value) => new Intl.NumberFormat('id-ID').format(value);
const totalDusunPopulation = demoDusun.reduce((sum, item) => sum + item.value, 0);
const chartPalette = ['#15803d', '#ca8a04', '#2563eb', '#dc2626', '#7c3aed', '#0891b2', '#c2410c'];
const apbdesByPeriod = Object.fromEntries(apbdesPeriods.map((period) => {
  const rows = allApbdesEntries
    .filter((entry) => entry.data.tahun === period.tahun && entry.data.versi === period.versi)
    .map((entry) => ({
      nama: entry.data.nama,
      jenis: entry.data.jenis,
      jumlah: entry.data.jumlah,
      realisasi: entry.data.realisasi ?? null,
      deskripsi: entry.data.deskripsi || '',
      urutan: entry.data.urutan,
    }));
  return [period.key, {
    rows,
    pendapatan: rows.filter((row) => row.jenis === 'Pendapatan').sort((a, b) => b.jumlah - a.jumlah),
    belanja: rows.filter((row) => row.jenis === 'Belanja').sort((a, b) => b.jumlah - a.jumlah),
  }];
}));

---

<Layout title={`Profil Desa - ${common.nama_desa || 'Desa Rancajaya'}`} description={`Profil lengkap Desa ${common.nama_desa || 'Rancajaya'} meliputi visi misi, perangkat desa, wilayah administrasi, demografi, dan transparansi APBDes.`}>

  <!-- 1. Hero -->
  <Hero
    eyebrow="Profil"
    title={`Profil Desa ${common.nama_desa || 'Rancajaya'}`}
    subtitle={`Mengenal lebih dekat Desa ${common.nama_desa || 'Rancajaya'}, Kecamatan ${common.kecamatan || 'Patokbeusi'}, Kabupaten ${common.kabupaten || 'Subang'}`}
  />

  <!-- 2. Sambutan Kepala Desa -->
  <section class="section bg-white">
    <div class="container-page">
      <div class="section-header">
        <span class="eyebrow animate-fade-in-up">Sambutan</span>
        <h2 class="section-title animate-fade-in-up stagger-1">Sambutan Kepala Desa</h2>
      </div>
      <div class="card p-6 md:p-8 animate-fade-in-up stagger-2">
        <div>
          <div>
            <p class="font-bold text-ink mb-1">{profil.nama_kades || '[Nama Kepala Desa]'}</p>
            <p class="text-sm text-muted mb-4">Kepala Desa {common.nama_desa || 'Rancajaya'}</p>
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-primary-200 mb-3">
              <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"></path>
              <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"></path>
            </svg>
            {profil.sambutan ? (
              profil.sambutan.split('\n').map((paragraph) => (
                paragraph.trim() && <p class="text-muted leading-relaxed italic mb-4">{paragraph}</p>
              ))
            ) : (
              <p class="text-muted leading-relaxed italic mb-4">"Sambutan belum tersedia."</p>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2b. Quick Navigation -->
  <section class="container-page -mt-4 relative z-20 mb-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <a href="#tentang-desa" class="card-hover p-4 flex flex-col items-center justify-center text-center group bg-white shadow-sm">
        <span class="font-semibold text-sm text-ink group-hover:text-primary-700">Visi, Misi, dan Tujuan</span>
      </a>
      <a href="#struktur-organisasi" class="card-hover p-4 flex flex-col items-center justify-center text-center group bg-white shadow-sm">
        <span class="font-semibold text-sm text-ink group-hover:text-primary-700">Struktur Organisasi</span>
      </a>
      <a href="#demografi" class="card-hover p-4 flex flex-col items-center justify-center text-center group bg-white shadow-sm">
        <span class="font-semibold text-sm text-ink group-hover:text-primary-700">Demografi Warga</span>
      </a>
      <a href="#apbdes" class="card-hover p-4 flex flex-col items-center justify-center text-center group bg-white shadow-sm">
        <span class="font-semibold text-sm text-ink group-hover:text-primary-700">Transparansi APBDes</span>
      </a>
    </div>
  </section>

  <!-- 3. Visi, Misi, dan Tujuan -->
  <section id="tentang-desa" class="section bg-paper">
    <div class="container-page">
      <div class="section-header">
        <span class="eyebrow">Arah Pembangunan Desa</span>
        <h2 class="section-title">Visi, Misi, dan Tujuan</h2>
      </div>

      <!-- Visi -->
      <div class="card p-6 md:p-8 mb-8 text-center border-primary-200 bg-gradient-to-br from-white to-primary-50 animate-fade-in-up stagger-2">
        <span class="eyebrow text-primary-700">Visi</span>
        <p class="text-lg md:text-xl font-display font-bold text-ink mt-3 leading-relaxed">
          "{common.visi || 'Visi belum tersedia'}"
        </p>
      </div>

      <!-- Misi -->
      <div>
        <h3 class="text-center font-display font-bold text-ink mb-6">Misi</h3>
        <div class="grid md:grid-cols-2 gap-4">
          {common.misi && common.misi.length > 0 ? (
            common.misi.map((misiItem, index) => (
              <div class="card p-5 animate-fade-in-up">
                <div class="flex gap-4">
                  <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-primary-700 text-white flex items-center justify-center font-bold font-display text-sm">{index + 1}</div>
                  <p class="text-muted leading-relaxed">{misiItem}</p>
                </div>
              </div>
            ))
          ) : (
            <p class="text-center text-muted col-span-2">Misi belum tersedia.</p>
          )}
        </div>
      </div>

      {common.tujuan && common.tujuan.length > 0 && (
        <div class="mt-10">
          <h3 class="text-center font-display font-bold text-ink mb-6">Tujuan Desa</h3>
          <div class="grid md:grid-cols-2 gap-4">
            {common.tujuan.map((tujuanItem, index) => (
              <div class="card p-5 animate-fade-in-up">
                <div class="flex gap-4">
                  <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-primary-700 text-white flex items-center justify-center font-bold font-display text-sm">{index + 1}</div>
                  <p class="text-muted leading-relaxed">{tujuanItem}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- 4. Struktur Organisasi -->
  <section id="struktur-organisasi" class="section bg-white">
    <div class="container-page">
      <div class="section-header">
        <span class="eyebrow animate-fade-in-up">Struktur Organisasi</span>
        <h2 class="section-title animate-fade-in-up stagger-1">Struktur Organisasi Pemerintah Desa</h2>
        <p class="section-subtitle animate-fade-in-up stagger-2">Susunan perangkat Pemerintah Desa Rancajaya.</p>
      </div>

      {kepalaDesa ? (
        <div class="max-w-5xl mx-auto">
          <div class="flex flex-col items-center">
            <div class="w-full max-w-xs rounded-xl border border-primary-300 bg-primary-700 px-5 py-4 text-center shadow-sm">
              <h3 class="text-sm font-semibold text-primary-100">{kepalaDesa.data.jabatan}</h3>
              <p class="font-display font-bold text-white mt-1">{kepalaDesa.data.nama}</p>
            </div>
            {sekretarisDesa && <><div class="h-6 w-px bg-primary-300"></div><div class="w-full max-w-xs rounded-xl border border-gold-300 bg-gold-50 px-5 py-4 text-center shadow-sm"><h4 class="text-sm font-semibold text-ink">{sekretarisDesa.data.jabatan}</h4><p class="font-display font-bold text-primary-800 mt-1">{sekretarisDesa.data.nama}</p></div></>}
          </div>
          <div class="mx-auto h-8 w-px bg-primary-300"></div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
            {organizationColumns.map((column) => (
              <div class="space-y-4">
                {column.map((member) => (
                  <div class="rounded-xl border border-line bg-white px-4 py-4 text-center shadow-sm">
                    <h4 class="text-sm font-semibold text-ink">{member.data.jabatan}</h4>
                    <p class="text-sm font-bold text-primary-700 mt-1">{member.data.nama}</p>
                  </div>
                ))}
              </div>
            ))}
          </div>
        </div>
      ) : (
          <p class="text-muted text-center">Data struktur organisasi belum ditambahkan.</p>
        )}
    </div>
  </section>

  <!-- 5. Wilayah Administrasi -->
  <section class="section bg-paper">
    <div class="container-page">
      <div class="section-header">
        <span class="eyebrow animate-fade-in-up">Wilayah</span>
        <h2 class="section-title animate-fade-in-up stagger-1">Wilayah Administrasi</h2>
        <p class="section-subtitle animate-fade-in-up stagger-2">Batas wilayah dan pembagian dusun Desa Rancajaya</p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- Batas Wilayah Table -->
        <div class="card overflow-hidden animate-fade-in-up stagger-1">
          <div class="px-5 py-4 bg-primary-700">
            <h3 class="font-display font-bold text-white text-sm flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              Batas Wilayah
            </h3>
          </div>
          <div class="divide-y divide-line">
            {(profil.batas_wilayah || []).map((batas) => (
              <div class="flex justify-between gap-4 px-5 py-3">
                <span class="text-sm font-medium text-ink">{batas.arah}</span>
                <span class="text-sm text-muted text-right">{batas.wilayah}</span>
              </div>
            ))}
            {(!profil.batas_wilayah || profil.batas_wilayah.length === 0) && (
              <p class="px-5 py-4 text-sm text-muted">Data batas wilayah belum ditambahkan.</p>
            )}
          </div>
          <div class="px-5 py-3 bg-primary-50 flex justify-between">
            <span class="text-sm font-bold text-primary-700">Luas Wilayah</span>
            <span class="text-sm font-bold text-primary-700">{profil.luas_wilayah || '0'}</span>
          </div>
        </div>

        <!-- Dusun List -->
        <div class="card overflow-hidden animate-fade-in-up stagger-2">
          <div class="px-5 py-4 bg-primary-700">
            <h3 class="font-display font-bold text-white text-sm flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
              Pembagian Dusun
            </h3>
          </div>
          <div class="divide-y divide-line">
            {sortedDusun.map((dusun, i) => (
              <div class="flex items-center gap-4 px-5 py-4">
                <div class="w-10 h-10 rounded-xl bg-primary-50 flex items-center justify-center flex-shrink-0">
                  <span class="text-sm font-bold text-primary-700">{i + 1}</span>
                </div>
                <div>
                  <h4 class="font-semibold text-sm text-ink">Dusun {dusun.data.nama}</h4>
                  <p class="text-xs text-muted">{dusun.data.kepala_dusun || 'Kepala dusun belum diisi'} / {formatNumber(dusun.data.jumlah_penduduk || 0)} jiwa{typeof dusun.data.jumlah_kk === 'number' ? ` / ${formatNumber(dusun.data.jumlah_kk)} KK` : ''}</p>
                  {(typeof dusun.data.jumlah_pria === 'number' || typeof dusun.data.jumlah_wanita === 'number') && (
                    <p class="text-xs text-muted mt-1">Laki-laki {formatNumber(dusun.data.jumlah_pria || 0)} / Perempuan {formatNumber(dusun.data.jumlah_wanita || 0)}</p>
                  )}
                </div>
              </div>
            ))}
            {sortedDusun.length === 0 && (
              <p class="px-5 py-4 text-sm text-muted">Data dusun belum ditambahkan.</p>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Demografi -->
  <section id="demografi" class="section bg-white">
    <div class="container-page">
      <div class="section-header">
        <span class="eyebrow">Data Penduduk</span>
        <h2 class="section-title">Demografi Warga</h2>
        <p class="section-subtitle">Visualisasi data kependudukan Desa {common.nama_desa || 'Rancajaya'}</p>
      </div>

      <!-- Stat Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        <StatCard value={`${profil.penduduk_total || '0'}`} label="Total Penduduk" variant="dark">
          <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </StatCard>
        <StatCard value={`${profil.penduduk_pria || '0'}`} label="Laki-laki" variant="male">
          <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7" r="4"/><path d="M5.5 21a6.5 6.5 0 0 1 13 0"/></svg>
        </StatCard>
        <StatCard value={`${profil.penduduk_wanita || '0'}`} label="Perempuan" variant="female">
          <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7" r="4"/><path d="M5.5 21a6.5 6.5 0 0 1 13 0"/><path d="M9 14h6"/></svg>
        </StatCard>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
        <p class="text-sm text-muted">Setiap legenda menampilkan jumlah warga per kelompok.</p>
        {profil.sumber_demografi && <span class="pill-primary">{profil.tahun_demografi ? `Data ${profil.tahun_demografi}` : 'Laporan Demografi'} / {profil.status_validasi_demografi || 'Dummy'}</span>}
      </div>

      <!-- Charts -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="card p-6">
          <div class="flex items-start justify-between gap-4 mb-4">
            <h3 class="font-display font-bold text-ink text-sm">Populasi per Dusun</h3>
            <span class="pill-primary shrink-0 text-right">{formatNumber(totalDusunPopulation)} jiwa</span>
          </div>
          <div class="relative h-56 w-full"><canvas id="chartDusun"></canvas></div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-4" aria-label="Legenda populasi per dusun">
            {demoDusun.map((row, index) => (
              <div class="flex items-center justify-between gap-3 rounded-md bg-paper px-3 py-2 text-xs">
                <span class="flex items-center gap-2 min-w-0"><span class="h-2.5 w-2.5 rounded-full shrink-0" style={`background-color: ${chartPalette[index % chartPalette.length]}`}></span><span class="truncate">{row.label}</span></span>
                <strong class="text-ink whitespace-nowrap">{formatNumber(row.value)} jiwa</strong>
              </div>
            ))}
          </div>
        </div>

        <div class="card p-6">
          <div class="flex items-start justify-between gap-4 mb-4">
            <h3 class="font-display font-bold text-ink text-sm">Tingkat Pendidikan</h3>
            <span class="pill-primary shrink-0 text-right">{formatNumber(pendidikanRows.reduce((sum, row) => sum + row.value, 0))} jiwa</span>
          </div>
          <div class="relative h-64 w-full"><canvas id="chartPendidikan"></canvas></div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-4" aria-label="Legenda tingkat pendidikan">
            {pendidikanRows.map((row, index) => (
              <div class="flex items-center justify-between gap-3 rounded-md bg-paper px-3 py-2 text-xs">
                <span class="flex items-center gap-2 min-w-0"><span class="h-2.5 w-2.5 rounded-full shrink-0" style={`background-color: ${chartPalette[index % chartPalette.length]}`}></span><span class="truncate">{row.label}</span></span>
                <strong class="text-ink whitespace-nowrap">{formatNumber(row.value)} jiwa</strong>
              </div>
            ))}
          </div>
        </div>

        <div class="card p-6">
          <div class="flex items-start justify-between gap-4 mb-4">
            <h3 class="font-display font-bold text-ink text-sm">Kelompok Umur</h3>
            <span class="pill-primary shrink-0 text-right">{formatNumber(umurRows.reduce((sum, row) => sum + row.value, 0))} jiwa</span>
          </div>
          <div class="relative h-72 w-full"><canvas id="chartUmur"></canvas></div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-4" aria-label="Legenda kelompok umur">
            {umurRows.map((row, index) => (
              <div class="flex items-center justify-between gap-3 rounded-md bg-paper px-3 py-2 text-xs">
                <span class="flex items-center gap-2 min-w-0"><span class="h-2.5 w-2.5 rounded-full shrink-0" style={`background-color: ${chartPalette[index % chartPalette.length]}`}></span><span class="truncate">{row.label}</span></span>
                <strong class="text-ink whitespace-nowrap">{formatNumber(row.value)} jiwa</strong>
              </div>
            ))}
          </div>
        </div>

        <div class="card p-6">
          <div class="flex items-start justify-between gap-4 mb-4">
            <h3 class="font-display font-bold text-ink text-sm">Pekerjaan Warga</h3>
            <span class="pill-primary shrink-0 text-right">{formatNumber(pekerjaanRows.reduce((sum, row) => sum + row.value, 0))} warga</span>
          </div>
          <div class="relative h-72 w-full"><canvas id="chartPekerjaan"></canvas></div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-4" aria-label="Legenda pekerjaan warga">
            {pekerjaanRows.map((row, index) => (
              <div class="flex items-center justify-between gap-3 rounded-md bg-paper px-3 py-2 text-xs">
                <span class="flex items-center gap-2 min-w-0"><span class="h-2.5 w-2.5 rounded-full shrink-0" style={`background-color: ${chartPalette[index % chartPalette.length]}`}></span><span class="truncate">{row.label}</span></span>
                <strong class="text-ink whitespace-nowrap">{formatNumber(row.value)} warga</strong>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script is:inline define:vars={{ demoDusun, demoPendidikan: pendidikanRows, demoUmur: umurRows, demoPekerjaan: pekerjaanRows, chartPalette }}>
    document.addEventListener("DOMContentLoaded", function() {
      if (!window.Chart) return;

      function renderPieChart(canvasId, rows) {
        const canvas = document.getElementById(canvasId);
        if (!canvas || !rows || rows.length === 0) return;
        new Chart(canvas.getContext('2d'), {
          type: 'pie',
          data: {
            labels: rows.map(d => d.label),
            datasets: [{
              data: rows.map(d => d.value),
              backgroundColor: chartPalette,
            }]
          },
          options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
        });
      }

      function renderBarChart(canvasId, rows, color) {
        const canvas = document.getElementById(canvasId);
        if (!canvas || !rows || rows.length === 0) return;
        new Chart(canvas.getContext('2d'), {
          type: 'bar',
          data: {
            labels: rows.map(d => d.label),
            datasets: [{
              label: 'Jumlah Penduduk',
              data: rows.map(d => d.value),
              backgroundColor: color,
            }]
          },
          options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
              x: {
                beginAtZero: true,
                ticks: { callback: (value) => new Intl.NumberFormat('id-ID').format(value) }
              }
            }
          }
        });
      }

      renderPieChart('chartDusun', demoDusun);
      renderBarChart('chartPendidikan', demoPendidikan, '#15803d');
      renderBarChart('chartUmur', demoUmur, '#2563eb');
      renderBarChart('chartPekerjaan', demoPekerjaan, '#ca8a04');
    });
  </script>

  <!-- 7. Transparansi APBDes -->
  <section id="apbdes" class="section bg-paper">
    <div class="container-page">
      <div class="section-header">
        <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4">
          <div>
            <span class="eyebrow">Keuangan Desa</span>
            <h2 class="section-title">Transparansi APBDes <span id="apbdesHeadingYear">{activeApbdesPeriod.tahun} - {activeApbdesPeriod.versi}</span></h2>
            <p class="section-subtitle">Data pemasukan dan belanja desa yang dapat difilter berdasarkan tahun dan versi dokumen APBDes.</p>
          </div>
          <label class="text-sm font-semibold text-ink">Periode APBDes
            <select id="apbdesYearSelect" class="mt-2 block w-full sm:w-auto rounded-md border border-line bg-white px-3 py-2 text-sm">
              {apbdesPeriods.map((period) => <option value={period.key} selected={period.key === activeApbdesPeriod.key}>{period.tahun} - APBDes {period.versi}</option>)}
            </select>
          </label>
        </div>
      </div>

      <div id="apbdesEmpty" class={`card p-8 text-center text-muted ${apbdesEntries.length > 0 ? 'hidden' : ''}`}>Data APBDes untuk tahun yang dipilih belum tersedia.</div>

      <div id="apbdesContent" class={apbdesEntries.length > 0 ? '' : 'hidden'}>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
          <div class="card p-6 border-green-200 bg-gradient-to-br from-white to-green-50">
            <p class="text-xs text-muted uppercase tracking-wider font-semibold mb-1">Total Pendapatan</p>
            <p id="apbdesTotalPendapatan" class="text-2xl font-display font-bold text-green-700">{formatRupiah(totalPendapatan)}</p>
          </div>
          <div class="card p-6 border-blue-200 bg-gradient-to-br from-white to-blue-50">
            <p class="text-xs text-muted uppercase tracking-wider font-semibold mb-1">Total Belanja</p>
            <p id="apbdesTotalBelanja" class="text-2xl font-display font-bold text-blue-700">{formatRupiah(totalBelanja)}</p>
          </div>
          <div class="card p-6 border-gold-200 bg-gradient-to-br from-white to-gold-50">
            <p class="text-xs text-muted uppercase tracking-wider font-semibold mb-1">Surplus/(Defisit)</p>
            <p id="apbdesTotalSaldo" class="text-2xl font-display font-bold text-gold-700">{formatRupiah(totalSaldo)}</p>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
          <div class="card p-6">
            <div class="flex items-start justify-between gap-4 mb-4">
              <h3 class="font-display font-bold text-ink text-sm">Rincian Pemasukan</h3>
              <span id="apbdesBadgePendapatan" class="pill-primary shrink-0 text-right">{formatRupiah(totalPendapatan)}</span>
            </div>
            <div class="relative h-80 w-full"><canvas id="chartPendapatan"></canvas></div>
            <div id="legendPendapatan" class="space-y-2 mt-4" aria-label="Legenda sumber pendapatan"></div>
          </div>
          <div class="card p-6">
            <div class="flex items-start justify-between gap-4 mb-4">
              <h3 class="font-display font-bold text-ink text-sm">Rincian Belanja</h3>
              <span id="apbdesBadgeBelanja" class="pill-primary shrink-0 text-right">{formatRupiah(totalBelanja)}</span>
            </div>
            <div class="relative h-80 w-full"><canvas id="chartBelanja"></canvas></div>
            <div id="legendBelanja" class="space-y-2 mt-4" aria-label="Legenda pos belanja"></div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <script is:inline define:vars={{
    apbdesByPeriod,
    activeApbdesPeriod,
  }}>
    document.addEventListener("DOMContentLoaded", function() {
      if (!window.Chart) return;

      const currency = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 });
      const compactCurrency = (value) => {
        if (value >= 1000000000) return `${(value / 1000000000).toFixed(1)} M`;
        if (value >= 1000000) return `${(value / 1000000).toFixed(1)} Jt`;
        return currency.format(value);
      };
      const formatCurrency = (value) => currency.format(value);
      const escapeHtml = (value) => String(value ?? '').replace(/[&<>\'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[character]));
      let chartPendapatan;
      let chartBelanja;

      function renderLegend(elementId, rows, color) {
        const element = document.getElementById(elementId);
        if (!element) return;
        element.innerHTML = rows.map((row) => `<div class="flex items-center justify-between gap-3 rounded-md bg-paper px-3 py-2 text-xs"><span class="flex min-w-0 items-center gap-2"><span class="h-2.5 w-2.5 shrink-0 rounded-full" style="background-color:${color}"></span><span class="truncate text-ink">${escapeHtml(row.label)}</span></span><strong class="whitespace-nowrap text-ink">${formatCurrency(row.value)}</strong></div>`).join('');
      }

      function renderBarChart(canvasId, rows, color, previousChart) {
        if (previousChart) previousChart.destroy();
        const canvas = document.getElementById(canvasId);
        if (!canvas || !rows.length) return undefined;
        return new Chart(canvas.getContext('2d'), {
          type: 'bar',
          data: {
            labels: rows.map((row) => row.label),
            datasets: [{ label: 'Jumlah', data: rows.map((row) => row.value), backgroundColor: color }]
          },
          options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
              x: { beginAtZero: true, ticks: { callback: compactCurrency } },
              y: {
                ticks: {
                  autoSkip: false,
                  callback(value) {
                    const label = this.getLabelForValue(value);
                    return label.length > 30 ? `${label.slice(0, 30)}…` : label;
                  }
                }
              }
            }
          }
        });
      }

      function renderApbdes(periodKey) {
        const data = apbdesByPeriod[periodKey] || { rows: [], pendapatan: [], belanja: [] };
        const totalPendapatan = data.pendapatan.reduce((sum, row) => sum + row.jumlah, 0);
        const totalBelanja = data.belanja.reduce((sum, row) => sum + row.jumlah, 0);
        const [year, version] = periodKey.split('-');
        document.getElementById('apbdesHeadingYear').textContent = `${year} - ${version === 'perubahan' ? 'Perubahan' : 'Awal'}`;
        document.getElementById('apbdesTotalPendapatan').textContent = formatCurrency(totalPendapatan);
        document.getElementById('apbdesTotalBelanja').textContent = formatCurrency(totalBelanja);
        document.getElementById('apbdesTotalSaldo').textContent = formatCurrency(totalPendapatan - totalBelanja);
        document.getElementById('apbdesBadgePendapatan').textContent = formatCurrency(totalPendapatan);
        document.getElementById('apbdesBadgeBelanja').textContent = formatCurrency(totalBelanja);
        document.getElementById('apbdesContent').classList.toggle('hidden', data.rows.length === 0);
        document.getElementById('apbdesEmpty').classList.toggle('hidden', data.rows.length > 0);
        renderLegend('legendPendapatan', data.pendapatan.map((row) => ({ label: row.nama, value: row.jumlah })), '#16a34a');
        renderLegend('legendBelanja', data.belanja.map((row) => ({ label: row.nama, value: row.jumlah })), '#2563eb');
        chartPendapatan = renderBarChart('chartPendapatan', data.pendapatan.map((row) => ({ label: row.nama, value: row.jumlah })), '#16a34a', chartPendapatan);
        chartBelanja = renderBarChart('chartBelanja', data.belanja.map((row) => ({ label: row.nama, value: row.jumlah })), '#2563eb', chartBelanja);
      }

      const select = document.getElementById('apbdesYearSelect');
      select?.addEventListener('change', (event) => renderApbdes(event.target.value));
      renderApbdes(activeApbdesPeriod.key);
    });
  </script>
</Layout>
