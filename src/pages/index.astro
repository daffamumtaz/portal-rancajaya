---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StatCard from '../components/StatCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { isPublishedContent, resolvePublicPath, toGoogleMapsEmbedUrl } from '../utils/content';

// Ambil data yang telah dipublikasikan
const umumData = await getEntry('pengaturan', 'umum');
const berandaData = await getEntry('halaman', 'beranda');
const profilData = await getEntry('halaman', 'profil');
const common = isPublishedContent(umumData?.data) ? umumData.data : {};
const beranda = isPublishedContent(berandaData?.data) ? berandaData.data : {};
const profil = isPublishedContent(profilData?.data) ? profilData.data : {};

const dusunEntries = (await getCollection('dusun')).filter((entry) => isPublishedContent(entry.data));
const apbdesEntries = (await getCollection('apbdes'))
  .filter((entry) => isPublishedContent(entry.data))
  .filter((entry) => entry.data.tahun === (common.tahun_apbdes_aktif || new Date().getFullYear()));
const potensiStats = (await getCollection('potensi-statistik'))
  .filter((entry) => isPublishedContent(entry.data))
  .filter((entry) => entry.data.kategori === 'Pertanian')
  .sort((a, b) => a.data.urutan - b.data.urutan);
const layananEntries = (await getCollection('layanan-administrasi'))
  .filter((entry) => isPublishedContent(entry.data))
  .sort((a, b) => a.data.urutan - b.data.urutan);
const umkmEntries = (await getCollection('umkm')).filter((entry) => isPublishedContent(entry.data));

const totalPendapatan = apbdesEntries.filter((entry) => entry.data.jenis === 'Pendapatan').reduce((sum, entry) => sum + entry.data.jumlah, 0);
const totalBelanja = apbdesEntries.filter((entry) => entry.data.jenis === 'Belanja').reduce((sum, entry) => sum + entry.data.jumlah, 0);
const formatRupiah = (value) => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(value);
const formatNumber = (value) => new Intl.NumberFormat('id-ID').format(value);
const activeApbdesYear = common.tahun_apbdes_aktif || new Date().getFullYear();
const homeStatValues = {
  'Luas Wilayah': profil.luas_wilayah || undefined,
  'Luas Sawah': profil.luas_sawah || undefined,
  'Jumlah RT': profil.jumlah_rt || undefined,
  'Jumlah Dusun': `${dusunEntries.length} Dusun`,
  'Jumlah Penduduk': profil.penduduk_total || undefined,
};
const configuredHomeStats = beranda.statistik?.length ? beranda.statistik : [
  { label: 'Luas Wilayah', value: '-' },
  { label: 'Jumlah Dusun', value: '-' },
  { label: 'Jumlah Penduduk', value: '-' },
  { label: 'Jumlah UMKM', value: '-' },
];
const homeStats = configuredHomeStats.map((stat) => ({
  ...stat,
  value: homeStatValues[stat.label] || (stat.label === 'Jumlah UMKM' ? `${umkmEntries.length} UMKM` : stat.value),
}));
const potensiPreview = potensiStats.slice(0, 4);
const layananPreview = layananEntries.slice(0, 3);

// Ambil 3 berita terbaru
const allArticles = (await getCollection('berita')).filter((entry) => isPublishedContent(entry.data));
const latestArticles = allArticles
  .filter(a => a.data.category === 'Berita' || a.data.category === 'Pengumuman')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// Ambil 3 artikel edukasi
const eduArticles = allArticles
  .filter(a => a.data.category === 'Artikel')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// Ambil 4 galeri terbaru
const allGallery = (await getCollection('galeri')).filter((entry) => isPublishedContent(entry.data));
const latestGallery = allGallery
  .sort((a, b) => b.data.tanggal.valueOf() - a.data.tanggal.valueOf())
  .slice(0, 4);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const mapEmbedUrl = toGoogleMapsEmbedUrl(common.koordinat_latitude, common.koordinat_longitude, 15, common.peta_query);
---

<Layout title="Beranda - Website Profil Desa Rancajaya" description="Website resmi Desa Rancajaya, Kecamatan Patokbeusi, Kabupaten Subang.">
  
  <!-- 1. Hero -->
  <Hero
    eyebrow="Selamat Datang di"
    title={beranda.hero_title || "Portal Rancajaya"}
    subtitle={beranda.hero_subtitle || "Media informasi, potensi desa, layanan masyarakat, dan digitalisasi UMKM Desa Rancajaya"}
    showCTA={true}
    ctaText="Jelajahi Desa"
    ctaHref={`${base}/profil`}
    bgImage={beranda.hero_bg}
  />

  <!-- 2. Quick Navigation -->
  <section class="container-page -mt-8 md:-mt-12 relative z-20 mb-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <a href={`${base}/profil`} class="card-hover p-6 flex flex-col items-center justify-center text-center group">
        <div class="w-12 h-12 rounded-full bg-primary-50 flex items-center justify-center text-primary-700 mb-3 group-hover:bg-primary-100 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/><path d="M12 10h.01"/><path d="M12 14h.01"/><path d="M16 10h.01"/><path d="M16 14h.01"/><path d="M8 10h.01"/><path d="M8 14h.01"/></svg>
        </div>
        <span class="font-semibold text-sm text-ink group-hover:text-primary-700">Profil {common.nama_desa || "Desa"}</span>
      </a>
      <a href={`${base}/informasi`} class="card-hover p-6 flex flex-col items-center justify-center text-center group">
        <div class="w-12 h-12 rounded-full bg-primary-50 flex items-center justify-center text-primary-700 mb-3 group-hover:bg-primary-100 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6Z"/></svg>
        </div>
        <span class="font-semibold text-sm text-ink group-hover:text-primary-700">Informasi</span>
      </a>
      <a href={`${base}/pertanian`} class="card-hover p-6 flex flex-col items-center justify-center text-center group">
        <div class="w-12 h-12 rounded-full bg-primary-50 flex items-center justify-center text-primary-700 mb-3 group-hover:bg-primary-100 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22v-5"/><path d="M9 7v2"/><path d="M15 7v2"/><path d="M12 2a5 5 0 0 0-5 5v5a5 5 0 0 0 10 0V7a5 5 0 0 0-5-5Z"/></svg>
        </div>
        <span class="font-semibold text-sm text-ink group-hover:text-primary-700">Potensi</span>
      </a>
      <a href={`${base}/layanan`} class="card-hover p-6 flex flex-col items-center justify-center text-center group">
        <div class="w-12 h-12 rounded-full bg-primary-50 flex items-center justify-center text-primary-700 mb-3 group-hover:bg-primary-100 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </div>
        <span class="font-semibold text-sm text-ink group-hover:text-primary-700">Layanan</span>
      </a>
    </div>
  </section>

  <!-- 3. Statistik Singkat -->
  <section class="section bg-white border-y border-line">
    <div class="container-page">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {homeStats.map((stat) => (
          <StatCard label={stat.label} value={stat.value}>
            <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </StatCard>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Ringkasan Data Desa -->
  <section class="section bg-paper border-b border-line">
    <div class="container-page">
      <div class="section-header">
        <span class="eyebrow">Data Terbaru</span>
        <h2 class="section-title">Ringkasan Desa</h2>
        <p class="section-subtitle">Ringkasan informasi Desa Rancajaya yang telah dipublikasikan.</p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="card p-6 md:p-7">
          <div class="flex items-start justify-between gap-4 mb-5">
            <div>
              <span class="eyebrow">APBDes</span>
              <h3 class="text-xl font-display font-bold text-ink mt-2">Tahun {activeApbdesYear}</h3>
            </div>
            <a href={`${base}/profil#apbdes`} class="text-xs font-semibold text-primary-700 hover:underline whitespace-nowrap">Lihat rincian</a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="rounded-md bg-primary-50 p-4"><span class="block text-xs text-muted">Pendapatan</span><strong class="block text-sm text-primary-800 mt-1">{formatRupiah(totalPendapatan)}</strong></div>
            <div class="rounded-md bg-blue-50 p-4"><span class="block text-xs text-muted">Belanja</span><strong class="block text-sm text-blue-800 mt-1">{formatRupiah(totalBelanja)}</strong></div>
            <div class="rounded-md bg-gold-50 p-4"><span class="block text-xs text-muted">Saldo</span><strong class="block text-sm text-gold-800 mt-1">{formatRupiah(totalPendapatan - totalBelanja)}</strong></div>
          </div>
        </div>

        <div class="card p-6 md:p-7">
          <div class="flex items-start justify-between gap-4 mb-5">
            <div>
              <span class="eyebrow">Potensi</span>
              <h3 class="text-xl font-display font-bold text-ink mt-2">Pertanian, Peternakan & UMKM</h3>
              <p class="text-xs text-muted mt-1">{formatNumber(umkmEntries.length)} UMKM terdata</p>
            </div>
            <a href={`${base}/pertanian`} class="text-xs font-semibold text-primary-700 hover:underline whitespace-nowrap">Jelajahi</a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {potensiPreview.map((stat) => (
              <div class="flex items-center justify-between gap-3 border-b border-line pb-3">
                <span class="text-sm text-muted truncate">{stat.data.label}</span>
                <strong class="text-sm text-ink whitespace-nowrap">{stat.data.value}</strong>
              </div>
            ))}
            {potensiPreview.length === 0 && <p class="text-sm text-muted">Data potensi belum tersedia.</p>}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Potensi Unggulan -->
  <section class="section bg-paper">
    <div class="container-page">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <span class="eyebrow mb-2">POTENSI UNGGULAN</span>
          <h2 class="section-title mb-4">{beranda.highlight_title || "Lumbung Padi di Utara Subang"}</h2>
          <p class="section-subtitle mb-6">{beranda.highlight_desc}</p>
          <a href={`${base}/pertanian`} class="btn-ghost">
            Jelajahi Potensi Desa
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
        <div class="relative">
          <div class="absolute inset-0 bg-gold-500 rounded-2xl transform translate-x-3 translate-y-3 opacity-20"></div>
          <div class="h-80 w-full bg-primary-100 rounded-2xl relative z-10 flex items-center justify-center border border-line overflow-hidden">
            {beranda.highlight_image ? (
              <img src={resolvePublicPath(beranda.highlight_image, base)} alt={beranda.highlight_title} class="w-full h-full object-cover" />
            ) : (
              <span class="text-primary-300 font-medium">Foto Hamparan Sawah</span>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Berita Terbaru -->
  <section class="section bg-white border-y border-line">
    <div class="container-page text-center">
      <div class="section-header">
        <span class="eyebrow mb-2">KABAR TERKINI</span>
        <h2 class="section-title">Berita & Pengumuman Terbaru</h2>
        <p class="section-subtitle mx-auto">Pantau terus perkembangan, pengumuman, dan agenda kegiatan di Desa Rancajaya.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left mb-10">
        {latestArticles.map((article) => {
          const dateFormatted = new Intl.DateTimeFormat('id-ID', {
            dateStyle: 'medium',
          }).format(article.data.date);

          return (
            <ArticleCard
              title={article.data.title}
              excerpt={article.data.excerpt}
              category={article.data.category}
              date={dateFormatted}
              slug={article.slug}
              thumbnail={article.data.thumbnail}
              featured={article.data.featured}
            />
          );
        })}
        {latestArticles.length === 0 && (
          <div class="col-span-3 text-center text-muted py-8">Belum ada berita yang dipublikasikan.</div>
        )}
      </div>
      
      <a href={`${base}/informasi`} class="btn-outline">
        Lihat Semua Berita
      </a>
    </div>
  </section>

  <!-- 5b. Artikel Edukasi -->
  <section class="section bg-paper border-b border-line">
    <div class="container-page text-center">
      <div class="section-header">
        <span class="eyebrow mb-2">EDUKASI MASYARAKAT</span>
        <h2 class="section-title">Artikel & Wawasan</h2>
          <p class="section-subtitle mx-auto">Kumpulan artikel edukatif seputar pertanian, kesehatan, dan pengembangan desa.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left mb-10">
        {eduArticles.map((article) => {
          const dateFormatted = new Intl.DateTimeFormat('id-ID', {
            dateStyle: 'medium',
          }).format(article.data.date);

          return (
            <ArticleCard
              title={article.data.title}
              excerpt={article.data.excerpt}
              category={article.data.category}
              date={dateFormatted}
              slug={article.slug}
              thumbnail={article.data.thumbnail}
              featured={article.data.featured}
            />
          );
        })}
        {eduArticles.length === 0 && (
          <div class="col-span-3 text-center text-muted py-8">Belum ada artikel edukasi yang dipublikasikan.</div>
        )}
      </div>
    </div>
  </section>

  <!-- 5c. Layanan Warga -->
  <section class="section bg-white border-b border-line">
    <div class="container-page">
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 mb-8">
        <div>
          <span class="eyebrow mb-2">LAYANAN WARGA</span>
          <h2 class="section-title">Administrasi Daring</h2>
          <p class="section-subtitle">Akses formulir dan informasi layanan desa dari satu tempat.</p>
        </div>
        <a href={`${base}/layanan`} class="btn-outline">Lihat semua layanan</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {layananPreview.map((item) => (
          <a href={`${base}/layanan`} class="card-hover p-5 group">
            <div class="flex items-center justify-between gap-3">
              <span class="text-xs font-semibold text-primary-700">{item.data.kategori}</span>
              <span class="text-xs text-muted">{item.data.biaya}</span>
            </div>
            <h3 class="font-bold text-ink mt-3 group-hover:text-primary-700">{item.data.nama}</h3>
            <p class="text-sm text-muted mt-2 line-clamp-2">{item.data.deskripsi}</p>
            <p class="text-xs text-primary-700 font-semibold mt-4">{item.data.durasi}</p>
          </a>
        ))}
        {layananPreview.length === 0 && <p class="text-sm text-muted">Data layanan belum tersedia.</p>}
      </div>
    </div>
  </section>

  <!-- 5d. Dokumentasi Kegiatan -->
  <section class="section bg-white border-b border-line">
    <div class="container-page text-center">
      <div class="section-header">
        <span class="eyebrow mb-2">GALERI</span>
        <h2 class="section-title">Dokumentasi Kegiatan Desa</h2>
        <p class="section-subtitle mx-auto">Potret ragam aktivitas, pembangunan, dan kebudayaan masyarakat Desa Rancajaya.</p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        {latestGallery.map((item) => (
          <div class="card overflow-hidden group cursor-pointer">
            <div class="h-48 overflow-hidden">
              <img src={resolvePublicPath(item.data.foto, base)} alt={item.data.alt_text || item.data.judul} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" loading="lazy" />
            </div>
            <div class="p-4 text-left">
              <h3 class="font-bold text-sm text-ink truncate">{item.data.judul}</h3>
              <p class="text-xs text-muted mt-1">{new Intl.DateTimeFormat('id-ID', { dateStyle: 'long' }).format(item.data.tanggal)}</p>
            </div>
          </div>
        ))}
        {latestGallery.length === 0 && (
          <div class="col-span-1 sm:col-span-2 md:col-span-4 text-center text-muted py-8">Belum ada dokumentasi foto yang diunggah.</div>
        )}
      </div>
    </div>
  </section>

  <!-- 6. Peta Lokasi -->
  <section id="peta-lokasi" class="section bg-paper">
    <div class="container-page">
      <div class="section-header">
        <span class="eyebrow">Lokasi</span>
        <h2 class="section-title">Peta Desa Rancajaya</h2>
        <p class="section-subtitle">Kecamatan Patokbeusi, Kabupaten Subang, Jawa Barat</p>
      </div>
      <div class="h-64 md:h-96 w-full rounded-2xl overflow-hidden shadow-lg border border-line">
        <iframe src={mapEmbedUrl} title={`Lokasi Kantor Desa ${common.nama_desa || 'Rancajaya'}`} width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>

</Layout>
