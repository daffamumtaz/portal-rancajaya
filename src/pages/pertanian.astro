---
import { getEntry, getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StatCard from '../components/StatCard.astro';
import { isPublishedContent, resolvePublicPath, toWhatsAppHref } from '../utils/content';

const potensiData = await getEntry('halaman', 'pertanian');
const umumData = await getEntry('pengaturan', 'umum');
const potensi = isPublishedContent(potensiData?.data) ? potensiData.data : {};
const common = isPublishedContent(umumData?.data) ? umumData.data : {};

const stats = (await getCollection('potensi-statistik')).filter((entry) => isPublishedContent(entry.data));
const kelompokTani = (await getCollection('kelompok-tani')).filter((entry) => isPublishedContent(entry.data));
const produksiPertanian = (await getCollection('produksi-pertanian')).filter((entry) => isPublishedContent(entry.data));
const umkm = (await getCollection('umkm')).filter((entry) => isPublishedContent(entry.data));

const sortByOrder = (a, b) => (a.data.urutan || 0) - (b.data.urutan || 0);
const pertanianStats = stats.filter((entry) => entry.data.kategori === 'Pertanian').sort(sortByOrder);
const saranaPertanian = stats.filter((entry) => entry.data.kategori === 'Sarana Pertanian').sort(sortByOrder);
const sortedProduksi = produksiPertanian.sort(sortByOrder);
const sortedKelompokTani = kelompokTani.sort((a, b) => a.data.nama.localeCompare(b.data.nama));
const sortedUmkm = umkm.sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.nama.localeCompare(b.data.nama));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const whatsappHref = toWhatsAppHref(common.telepon);
const totalLuasKelompok = sortedKelompokTani.reduce((sum, item) => sum + item.data.luas_ha, 0);
const totalAnggotaKelompok = sortedKelompokTani.reduce((sum, item) => sum + item.data.jumlah_anggota, 0);
const formatNumber = (value) => new Intl.NumberFormat('id-ID', { maximumFractionDigits: 2 }).format(value);
const peternakanSlides = (potensi.peternakan_galeri || []).map((item) => ({
  src: resolvePublicPath(item.foto, base),
  alt: item.alt_text,
})).filter((item) => item.src);
const sourceForEntries = (entries) => [...new Set(entries.map((entry) => entry.data.sumber_data).filter(Boolean))].join('; ');
const pertanianSource = sourceForEntries(pertanianStats);
const produksiSource = sourceForEntries(sortedProduksi);
const saranaSource = sourceForEntries(saranaPertanian);
const kelompokTaniSource = sourceForEntries(sortedKelompokTani);
---

<Layout title={`Potensi Desa Rancajaya - Pertanian, Peternakan & UMKM`} description={`Potensi pertanian, peternakan domba, UMKM, dan ekonomi lokal Desa Rancajaya, Kecamatan Patokbeusi, Kabupaten Subang.`}>
  <Hero eyebrow="Potensi Desa" title={potensi.hero_title || 'Potensi Desa'} subtitle={potensi.hero_subtitle || `Potensi pertanian, peternakan domba, UMKM, dan ekonomi lokal ${common.nama_desa || 'Desa Rancajaya'}`} />

  <section class="section bg-white border-b border-line">
    <div class="container-page">
      <div class="section-header">
        <div class="flex items-start justify-between gap-4">
          <div>
            <span class="eyebrow">Pertanian</span>
            <h2 class="section-title">Potensi Pertanian</h2>
            <p class="section-subtitle">{potensi.deskripsi || 'Potensi Desa Rancajaya mencakup pertanian, peternakan domba, dan UMKM warga.'}</p>
          </div>
          <span class="pill-primary shrink-0">{pertanianStats.length} indikator</span>
        </div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {pertanianStats.slice(0, 4).map((stat, index) => (
          <StatCard label={stat.data.label} value={stat.data.value} variant={index === 0 ? 'dark' : 'light'}>
            <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22v-5"/><path d="M9 7v2"/><path d="M15 7v2"/><path d="M12 2a5 5 0 0 0-5 5v5a5 5 0 0 0 10 0V7a5 5 0 0 0-5-5Z"/></svg>
          </StatCard>
        ))}
      </div>
      {pertanianSource && <p class="mt-5 text-xs leading-relaxed text-muted"><strong class="text-ink">Sumber:</strong> {pertanianSource}.</p>}
    </div>
  </section>

  <section class="section bg-paper border-b border-line">
    <div class="container-page">
      <div class="section-header">
        <span class="eyebrow">Produksi 2026</span>
        <h2 class="section-title">Produksi Pertanian dan Hortikultura</h2>
        <p class="section-subtitle">Data luas, produktivitas, dan hasil produksi komoditas pertanian Desa Rancajaya.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {sortedProduksi.map((item, index) => (
          <article class:list={["card p-5 md:p-6 flex flex-col", { "bg-primary-800 text-white sm:col-span-2 lg:col-span-1": index === 0 }]}>
            <span class:list={["text-xs font-semibold uppercase tracking-wide", index === 0 ? "text-primary-100" : "text-primary-700"]}>{item.data.kategori}</span>
            <h3 class:list={["mt-2 font-display text-xl font-bold", index === 0 ? "text-white" : "text-ink"]}>{item.data.nama}</h3>
            <div class="mt-5">
              <span class:list={["block text-xs", index === 0 ? "text-primary-100" : "text-muted"]}>Produksi</span>
              <strong class:list={["mt-1 block font-display text-3xl", index === 0 ? "text-white" : "text-primary-800"]}>{formatNumber(item.data.produksi_ton)} ton</strong>
            </div>
            <div class:list={["mt-5 grid grid-cols-2 gap-4 border-t pt-4 text-sm", index === 0 ? "border-primary-600" : "border-line"]}>
              <div><span class:list={["block text-xs", index === 0 ? "text-primary-100" : "text-muted"]}>Luas</span><strong>{formatNumber(item.data.luas_ha)} ha</strong></div>
              <div><span class:list={["block text-xs", index === 0 ? "text-primary-100" : "text-muted"]}>Produktivitas</span><strong>{item.data.produktivitas}</strong></div>
            </div>
          </article>
        ))}
      </div>
      <p class="mt-5 text-xs leading-relaxed text-muted">Angka produksi dikonversi dari kuintal menjadi ton. {produksiSource && <><strong class="text-ink">Sumber:</strong> {produksiSource}.</>}</p>
    </div>
  </section>

  <section class="section bg-paper border-b border-line">
    <div class="container-page grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-center">
      <div class="section-header mb-0">
        <span class="eyebrow">Peternakan</span>
        <h2 class="section-title">Peternakan Domba Warga</h2>
        <p class="section-subtitle">{potensi.peternakan_copywriting || 'Peternakan domba menjadi salah satu potensi masyarakat Desa Rancajaya.'}</p>
      </div>
      <div data-peternakan-carousel class="relative overflow-hidden rounded-2xl bg-primary-100 shadow-lg">
        {peternakanSlides.length > 0 ? (
          <>
            <div class="h-72 sm:h-96">
              {peternakanSlides.map((slide, index) => <img data-peternakan-slide src={slide.src} alt={slide.alt} class:list={["w-full h-full object-cover", { hidden: index !== 0 }]} loading={index === 0 ? 'eager' : 'lazy'} />)}
            </div>
            {peternakanSlides.length > 1 && (
              <>
                <button data-peternakan-prev type="button" class="absolute left-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/90 text-primary-800 shadow flex items-center justify-center hover:bg-white" aria-label="Foto sebelumnya"><span aria-hidden="true">‹</span></button>
                <button data-peternakan-next type="button" class="absolute right-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/90 text-primary-800 shadow flex items-center justify-center hover:bg-white" aria-label="Foto berikutnya"><span aria-hidden="true">›</span></button>
                <div class="absolute bottom-4 inset-x-0 flex justify-center gap-2">
                  {peternakanSlides.map((_, index) => <button data-peternakan-dot={index} type="button" class:list={["w-2.5 h-2.5 rounded-full bg-white/70", { "bg-white w-6": index === 0 }]} aria-label={`Tampilkan foto ${index + 1}`} />)}
                </div>
              </>
            )}
          </>
        ) : <p class="h-72 flex items-center justify-center text-muted">Dokumentasi peternakan domba belum ditambahkan.</p>}
      </div>
    </div>
  </section>

  <section class="section bg-white border-b border-line">
    <div class="container-page">
      <div class="section-header">
        <span class="eyebrow">Sarana Pertanian</span>
        <h2 class="section-title">Peralatan Pendukung Usaha Tani</h2>
        <p class="section-subtitle">Sarana yang tercatat untuk mendukung pengairan, budidaya, panen, dan pengolahan hasil pertanian.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
        {saranaPertanian.map((item) => <article class="card p-5 text-center"><span class="block text-xs font-semibold uppercase tracking-wide text-muted">{item.data.label}</span><strong class="mt-2 block font-display text-2xl text-primary-800">{item.data.value}</strong></article>)}
      </div>
      {saranaSource && <p class="mt-5 text-xs leading-relaxed text-muted"><strong class="text-ink">Sumber:</strong> {saranaSource}.</p>}
    </div>
  </section>

  <section class="section bg-white border-b border-line">
    <div class="container-page">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 gap-4">
        <div><span class="eyebrow mb-2">Kelembagaan Petani</span><h2 class="section-title">Kelompok Tani</h2><p class="section-subtitle">Delapan kelompok tani padi yang tergabung dalam Gapoktan {potensi.gapoktan_nama || 'SRIJAYA'}.</p></div>
        <span class="pill-primary">{sortedKelompokTani.length} kelompok terdata</span>
      </div>
      <div class="mb-6 rounded-2xl bg-primary-800 p-5 md:p-6 text-white">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
          <div class="col-span-2 md:col-span-1"><span class="text-xs uppercase tracking-wide text-primary-100">Gapoktan</span><strong class="mt-1 block font-display text-xl">{potensi.gapoktan_nama || 'SRIJAYA'}</strong></div>
          <div><span class="text-xs uppercase tracking-wide text-primary-100">Ketua</span><strong class="mt-1 block">{potensi.gapoktan_ketua || 'Pak Syarif'}</strong></div>
          <div><span class="text-xs uppercase tracking-wide text-primary-100">Luas Areal</span><strong class="mt-1 block">{formatNumber(totalLuasKelompok)} ha</strong></div>
          <div><span class="text-xs uppercase tracking-wide text-primary-100">Jumlah Anggota</span><strong class="mt-1 block">{formatNumber(totalAnggotaKelompok)} orang</strong></div>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {sortedKelompokTani.map((poktan) => <article class="card p-5"><div class="flex items-start gap-4"><div class="w-12 h-12 rounded-full bg-primary-50 flex items-center justify-center text-primary-700 shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div><div class="min-w-0 flex-1"><h3 class="font-bold text-ink text-lg">{poktan.data.nama}</h3><p class="text-xs text-muted">Ketua: <strong class="text-ink">{poktan.data.ketua}</strong></p><div class="mt-4 grid grid-cols-2 sm:grid-cols-3 gap-3 text-sm"><div><span class="block text-muted text-xs">Luas</span><span class="font-semibold text-ink">{formatNumber(poktan.data.luas_ha)} ha</span></div><div><span class="block text-muted text-xs">Anggota</span><span class="font-semibold text-ink">{poktan.data.jumlah_anggota} orang</span></div><div><span class="block text-muted text-xs">Komoditas</span><span class="font-semibold text-primary-700">{poktan.data.komoditas_utama}</span></div></div></div></div></article>)}
        {sortedKelompokTani.length === 0 && <p class="text-muted col-span-2 text-center">Data kelompok tani belum ditambahkan.</p>}
      </div>
      {kelompokTaniSource && <p class="mt-5 text-xs leading-relaxed text-muted"><strong class="text-ink">Sumber:</strong> {kelompokTaniSource}.</p>}
    </div>
  </section>

  <section class="section bg-paper border-b border-line">
    <div class="container-page"><div class="section-header"><div class="flex items-start justify-between gap-4"><div><span class="eyebrow">UMKM</span><h2 class="section-title">UMKM Desa</h2><p class="section-subtitle">Pelaku usaha lokal dari tiga dusun di Desa Rancajaya.</p></div><span class="pill-primary shrink-0">{sortedUmkm.length} UMKM</span></div></div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {sortedUmkm.map((item) => {
          const contactHref = toWhatsAppHref(item.data.kontak);
          const contactName = item.data.kontak?.match(/\(([^)]+)\)/)?.[1] || item.data.pemilik;
          const contactNumber = item.data.kontak?.replace(/\s*\([^)]+\)\s*$/, '');
          return <article class="card overflow-hidden h-full flex flex-col"><div class="h-56 bg-primary-50 flex items-center justify-center overflow-hidden">{item.data.foto ? <img src={resolvePublicPath(item.data.foto, base)} alt={item.data.produk_utama} class="w-full h-full object-cover" loading="lazy" /> : <span class="text-primary-300 font-medium">Foto UMKM</span>}</div><div class="p-5 flex flex-col flex-1"><span class="inline-flex self-start rounded-full bg-primary-50 px-3 py-1 text-xs font-semibold text-primary-700">Dusun {item.data.dusun || 'belum diisi'}</span><h3 class="font-display font-bold text-xl text-ink mt-3">{item.data.produk_utama}</h3><p class="text-sm text-muted leading-relaxed mt-3">{item.data.deskripsi}</p><p class="text-xs text-muted mt-4">Pelaku usaha: <strong class="text-ink">{item.data.pemilik}</strong></p><div class="mt-auto pt-5 border-t border-line"><span class="block text-xs uppercase tracking-wide text-muted font-semibold mb-1">Kontak</span>{contactHref ? <a href={contactHref} target="_blank" rel="noopener noreferrer" class="inline-flex flex-col text-sm text-primary-700 font-semibold hover:underline"><span>{contactName}</span><span>{contactNumber}</span></a> : <span class="text-sm text-muted">Kontak belum tersedia</span>}</div></div></article>;
        })}
        {sortedUmkm.length === 0 && <p class="text-muted col-span-3 text-center">Data UMKM belum ditambahkan.</p>}
      </div>
    </div>
  </section>

  <section class="section bg-paper"><div class="container-page"><div class="card p-6 md:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6"><div><span class="eyebrow">Kolaborasi</span><h2 class="text-2xl font-bold font-display text-ink mt-2">Kembangkan Potensi {common.nama_desa || 'Desa Rancajaya'}</h2><p class="text-sm text-muted mt-2 max-w-2xl">Warga dapat menghubungi desa untuk memperbarui data kelompok tani, peternakan, dan UMKM.</p></div>{whatsappHref ? <a href={whatsappHref} class="btn-primary" target="_blank" rel="noopener noreferrer">Hubungi Desa</a> : <a href={`${base}/layanan`} class="btn-primary">Lihat Kontak Desa</a>}</div></div></section>
</Layout>

<script>
  document.querySelectorAll('[data-peternakan-carousel]').forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll('[data-peternakan-slide]'));
    const dots = Array.from(carousel.querySelectorAll('[data-peternakan-dot]'));
    if (slides.length < 2) return;
    let activeIndex = 0;
    const showSlide = (index) => {
      activeIndex = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => slide.classList.toggle('hidden', slideIndex !== activeIndex));
      dots.forEach((dot, dotIndex) => {
        dot.classList.toggle('bg-white', dotIndex === activeIndex);
        dot.classList.toggle('w-6', dotIndex === activeIndex);
        dot.setAttribute('aria-current', String(dotIndex === activeIndex));
      });
    };
    carousel.querySelector('[data-peternakan-prev]')?.addEventListener('click', () => showSlide(activeIndex - 1));
    carousel.querySelector('[data-peternakan-next]')?.addEventListener('click', () => showSlide(activeIndex + 1));
    dots.forEach((dot, index) => dot.addEventListener('click', () => showSlide(index)));
  });
</script>
