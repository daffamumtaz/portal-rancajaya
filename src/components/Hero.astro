---
import { resolvePublicPath } from '../utils/content';

interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  showCTA?: boolean;
  ctaText?: string;
  ctaHref?: string;
  bgImage?: string;
}

const { 
  title, 
  subtitle, 
  eyebrow, 
  showCTA = false, 
  ctaText = "Pelajari Lebih Lanjut", 
  ctaHref = "#",
  bgImage
} = Astro.props;

// Jika bgImage kosong/undefined tapi diminta dari CMS, kita gunakan gambar fallback
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fallbackBg = resolvePublicPath('/images/SawahRancajaya.jpg', base);
const finalBgImage = resolvePublicPath(bgImage, base) || fallbackBg;
---

<div class={`relative overflow-hidden isolate ${!bgImage ? 'bg-gradient-to-br from-primary-800 to-primary-600 text-white' : 'text-white'}`}>
  {/* If bgImage is used, render the img tag */}
  <img 
    src={finalBgImage} 
    alt="Hero Background" 
    class="absolute inset-0 w-full h-full object-cover z-0"
  />
  {/* Dark overlay for readability */}
  <div class="absolute inset-0 bg-primary-900/60 z-0"></div>

  <div class="container-page relative z-10 py-20 md:py-32 flex flex-col items-center text-center justify-center min-h-[300px] md:min-h-[400px]">
    {eyebrow && (
      <span class="inline-block mb-3 px-3 py-1 rounded-pill bg-gold-500/20 text-gold-300 text-xs font-bold uppercase tracking-widest animate-fade-in-up">
        {eyebrow}
      </span>
    )}
    
    <h1 class="font-display text-3xl md:text-5xl font-bold mb-4 max-w-3xl leading-tight animate-fade-in-up stagger-1">
      {title}
    </h1>
    
    {subtitle && (
      <p class="text-base md:text-lg text-primary-50 max-w-2xl animate-fade-in-up stagger-2">
        {subtitle}
      </p>
    )}
    
    {showCTA && (
      <div class="mt-8 animate-fade-in-up stagger-3">
        <a href={ctaHref} class="btn-gold !px-8 !py-3.5 !text-base shadow-lg shadow-gold-500/20">
          {ctaText}
        </a>
      </div>
    )}
  </div>
</div>
