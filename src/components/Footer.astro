---
import { getEntry } from 'astro:content';
import { isPublishedContent, toGoogleMapsEmbedUrl } from '../utils/content';

const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const umumData = await getEntry('pengaturan', 'umum');
const common = isPublishedContent(umumData?.data) ? umumData.data : {};
const mapEmbedUrl = toGoogleMapsEmbedUrl(common.koordinat_latitude, common.koordinat_longitude, common.peta_zoom);
const navLinks = [
  { name: 'Beranda', href: `${base}/` },
  { name: 'Profil Desa', href: `${base}/profil` },
  { name: 'Informasi', href: `${base}/informasi` },
  { name: 'Potensi', href: `${base}/pertanian` },
  { name: 'Layanan', href: `${base}/layanan` },
];
---

<footer class="bg-primary-900 text-white py-12 md:py-16">
  <div class="container-page">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      <!-- Brand -->
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <img src={`${base}/images/logo.png`} alt="Logo Pemerintah Kabupaten Subang" class="w-10 h-10 object-contain shrink-0" />
          <div class="flex flex-col leading-tight">
            <span class="font-display font-bold text-white text-sm tracking-wide">PORTAL RANCAJAYA</span>
          </div>
        </div>
        <p class="text-primary-100 text-sm mt-2">
          Sebuah desa yang terletak di Kecamatan Patokbeusi, Kabupaten Subang, Provinsi Jawa Barat, Indonesia.
        </p>
        <div class="flex items-center gap-3 mt-2">
          <a href={common.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook Pemerintah Desa Rancajaya" class="w-8 h-8 rounded-full bg-primary-800 flex items-center justify-center hover:bg-gold-500 hover:text-primary-900 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href={common.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube Pemerintah Desa Rancajaya" class="w-8 h-8 rounded-full bg-primary-800 flex items-center justify-center hover:bg-gold-500 hover:text-primary-900 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 17a24.12 24.12 0 0 1 0-10C3 4.5 4.5 3 7 3h10c2.5 0 4 1.5 4.5 4a24.12 24.12 0 0 1 0 10c-.5 2.5-2 4-4.5 4H7c-2.5 0-4-1.5-4.5-4Z"/><path d="m10 9 5 3-5 3Z"/></svg>
          </a>
        </div>
      </div>

      <!-- Navigasi -->
      <div>
        <h3 class="font-display font-semibold text-lg mb-4 text-gold-500">Navigasi</h3>
        <ul class="flex flex-col gap-3">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-primary-100 hover:text-white hover:underline transition-all">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Kontak -->
      <div>
        <h3 class="font-display font-semibold text-lg mb-4 text-gold-500">Kontak</h3>
        <ul class="flex flex-col gap-4 text-sm text-primary-100">
          <li class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>{common.alamat_kantor || 'Jl. Raya Rancajaya No. 01, Desa Rancajaya, Kec. Patokbeusi, Kab. Subang, Jawa Barat'}</span>
          </li>
          <li class="mt-2">
            <iframe src={mapEmbedUrl} title={`Lokasi Kantor Desa ${common.nama_desa || 'Rancajaya'}`} width="100%" height="120" style="border:0; border-radius: 0.5rem;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          </li>
          <li class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <span>{common.email || 'desa.rancajaya@gmail.com'}</span>
          </li>
          <li class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>{common.telepon || '(0260) 1234567'}{common.telepon && !common.telepon.includes('Pak Ujang') && ' (Pak Ujang)'}</span>
          </li>
        </ul>
      </div>

      <!-- Jam Operasional -->
      <div>
        <h3 class="font-display font-semibold text-lg mb-4 text-gold-500">Jam Operasional</h3>
        <ul class="flex flex-col gap-3 text-sm text-primary-100">
          <li>
            <span>{common.jam_operasional || 'Senin - Jumat 08:00 - 16:00'}</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-primary-700/50 my-8"></div>

    <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-primary-200">
      <p>&copy; {currentYear} Portal Rancajaya. Hak Cipta Dilindungi.</p>
      <p>Dikelola oleh Tim KKN 2026.</p>
    </div>
  </div>
</footer>
